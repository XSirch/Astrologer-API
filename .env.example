# ──────────────────────────────────────────────────────────────────────────────
# Astrologer API – Environment Variables
# Copy this file to .env and fill in the values before running the server.
# .env is gitignored and must NEVER be committed.
# ──────────────────────────────────────────────────────────────────────────────

# Environment type — controls which config/*.toml file is loaded.
# Accepted values: dev | test | production
# Omitting this variable defaults to production.
ENV_TYPE=production

# ── Authentication secrets ────────────────────────────────────────────────────
# Found in your RapidAPI Provider Dashboard → Security → Proxy Secret.
# Required in production. Leave empty for local dev (ENV_TYPE=dev bypasses auth).
RAPID_API_SECRET_KEY=

# Key used by the Astrologer Studio proxy (optional — leave empty if unused).
ASTROLOGER_STUDIO_SECRET_KEY=

# Key for private/internal access (optional — leave empty if unused).
PRIVATE_ASTROLOGER_API_SECRET_KEY=

# Direct RapidAPI consumer key — used for internal testing/health checks.
RAPID_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
# Accepted values: DEBUG | INFO | WARNING | ERROR | CRITICAL (or integer 10-50).
# Overrides the log_level set in the .toml config files.
# LOG_LEVEL=INFO
